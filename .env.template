# Environment Configuration Template
# Copy this to .env and update values for your environment

# Application
ENV=dev
API_V1_STR=/api/v1
PROJECT_NAME=VULCAN API
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# SQLite (Optional - kept for backward compatibility)
DATABASE_URL=sqlite+aiosqlite:///./vulcan.db

# MongoDB Configuration
# Connection URI (if set, overrides individual connection parameters)
# MONGO_URI=mongodb://user:password@host:27017/vulcan?authSource=admin

# Individual MongoDB parameters (used if MONGO_URI is not set)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB_NAME=vulcan
MONGO_USER=vulcan_user
MONGO_PASSWORD=secure_password_here

# JWT Security
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=43200

# Default Admin Account
DEFAULT_ADMIN_EMAIL=admin@vulcan.ai
DEFAULT_ADMIN_PASSWORD=admin123!

# Frontend URL
FRONTEND_BASE_URL=http://localhost:3000

# Password reset
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# SMTP (required for forgot password emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Vulcan Security
SENDGRID_API_KEY=
# Optional NVD API key for faster CVE-enrichment rate limits: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
# Google OAuth
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback
FRONTEND_OAUTH_REDIRECT_URL=http://localhost:3000/oauth/callback

# GitHub OAuth
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/github/callback
# Repository storage
REPO_STORAGE_DIR=repo_uploads

# Optional: LLM Configuration
# OPENAI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_key_here
# GROQ_API_KEY=your_key_here
